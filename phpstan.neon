includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    tmpDir: %currentWorkingDirectory%/storage/framework/cache/phpstan

    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - Modules/

    excludePaths:
        - Modules/*/resources/*
        - Modules/*/tests/*

    level: 7

    configDirectories:
        - %currentWorkingDirectory%/config
        - %currentWorkingDirectory%/Modules/*/config
