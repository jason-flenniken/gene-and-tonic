APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the longest job timeout (research job: 200s) or a running job is reserved twice.
DB_QUEUE_RETRY_AFTER=240

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LARAVEL_PDF_DRIVER=chrome

OPENAI_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev

# AI_LOG_REQUESTS=true

# Supplement research (AI call). Defaults shown.
# AI_RESEARCH_PROVIDER=openai
# AI_RESEARCH_MODEL=gpt-6.1-sol
# AI_RESEARCH_EFFORT=medium
# AI_RESEARCH_MAX_TOKENS=8000
# AI_RESEARCH_TIMEOUT=120
# Minutes a research run may stay active before supplements:reap-stale fails it.
# RESEARCH_REAP_AFTER_MINUTES=15
# Most genes of one supplement researched for genetic interactions.
# RESEARCH_GENE_LIMIT=4

# Web research driver and Firecrawl options. Defaults shown.
# RESEARCH_DRIVER=firecrawl
# FIRECRAWL_TIMEOUT=60
# FIRECRAWL_MAX_RESULTS=8

# PDF rendering (Chrome driver). Defaults shown; chrome-php auto-discovers the binary.
# LARAVEL_PDF_CHROME_BINARY="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# LARAVEL_PDF_CHROME_NO_SANDBOX=false
# LARAVEL_PDF_CHROME_STARTUP_TIMEOUT=30
# LARAVEL_PDF_CHROME_TIMEOUT=30000
# LARAVEL_PDF_CHROME_OPERATION_TIMEOUT=5000
# LARAVEL_PDF_CHROME_USER_DATA_DIR=

# Reports: template used when a request names none (clinical or modern).
# REPORTS_DEFAULT_TEMPLATE=clinical

# Opt-in real-Chrome render test (see CLAUDE.md). Not read by the app.
# RUN_CHROME_TESTS=0

# Demo user created by DemoUserSeeder (php artisan db:seed). Defaults shown.
# DEMO_USER_NAME="Demo User"
# DEMO_USER_EMAIL=demo@example.com
# DEMO_USER_PASSWORD=password  (outside local/testing the seeder refuses unless this is a non-default value)

# Genetics uploads. Defaults shown. Also raise Herd's PHP upload_max_filesize and post_max_size to 25M.
# GENETICS_MAX_UPLOAD_KB=25600
# GENETICS_MAX_MARKER_ROWS=1000
# Most characters of marker lines sent to the model in one extraction call.
# GENETICS_EXTRACT_MAX_CHARS=20000
# Most extraction calls one upload makes; each can take up to AI_GENETICS_EXTRACT_TIMEOUT.
# GENETICS_EXTRACT_MAX_CHUNKS=3
# Share of a marker CSV's rsID rows the local parser must read; below it the rows go to the model instead.
# GENETICS_LOCAL_MIN_RATIO=0.8
# Most lookups one upload queues; the rest stay pending until someone presses Look up.
# GENETICS_LOOKUP_CAP=15
# Domains the SNP lookup may search (comma separated).
# GENETICS_LOOKUP_DOMAINS=snpedia.com,ncbi.nlm.nih.gov,ebi.ac.uk
# Minutes an upload or lookup may stay active before genetics:reap-stale fails it.
# GENETICS_REAP_AFTER_MINUTES=15

# Genetics AI profiles (marker extraction from PDF/unknown files, SNP lookup, variant grouping). Defaults shown.
# AI_GENETICS_EXTRACT_PROVIDER=openai
# AI_GENETICS_EXTRACT_MODEL=gpt-6-luna
# AI_GENETICS_EXTRACT_EFFORT=low
# AI_GENETICS_EXTRACT_MAX_TOKENS=4000
# AI_GENETICS_EXTRACT_TIMEOUT=60
# AI_GENETICS_LOOKUP_PROVIDER=openai
# AI_GENETICS_LOOKUP_MODEL=gpt-6-luna
# AI_GENETICS_LOOKUP_EFFORT=low
# AI_GENETICS_LOOKUP_MAX_TOKENS=3000
# AI_GENETICS_LOOKUP_TIMEOUT=60
# AI_GENETICS_GROUP_PROVIDER=openai
# AI_GENETICS_GROUP_MODEL=gpt-6-luna
# AI_GENETICS_GROUP_EFFORT=low
# AI_GENETICS_GROUP_MAX_TOKENS=4000
# AI_GENETICS_GROUP_TIMEOUT=60
