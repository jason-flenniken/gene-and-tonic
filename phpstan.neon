includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - Modules/

    excludePaths:
        - Modules/*/resources/*
        - Modules/*/tests/*

    level: 7

    ignoreErrors:
        # Consumed by DTOs in later tasks; remove once a production class uses it.
        -
            identifier: trait.unused
            path: Modules/Shared/app/Data/Concerns/ArrayableData.php
